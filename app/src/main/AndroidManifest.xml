<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Package-visibility declaration (Android 11+/API 30+) for the TextToSpeech engine the
         read-aloud feature (RecipeDetailScreen.kt) depends on. Without this, TextToSpeech's
         engine discovery/binding can silently fail or misbehave depending on OS version and OEM
         TTS packaging; this is the only queries entry needed.

         The one other implicit-intent dependency, opening the Play Store listing from About
         (ui/PlayStore.kt), deliberately needs no entry here: package visibility filters queries
         such as resolveActivity() and queryIntentActivities(), but never startActivity()
         dispatch, and that code calls startActivity() blindly and falls back to the https URL.
         If a resolveActivity() guard is ever added there, this entry (or an equivalent
         <package android:name="com.android.vending" />) becomes required, or the market://
         branch silently becomes unreachable. Same failure class as the TTS one above. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KitchenAssistant">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.KitchenAssistant">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>